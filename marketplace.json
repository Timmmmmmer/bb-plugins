{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "bb-plugins",
  "displayName": "Team plugins (Timmmmmmer/bb-plugins)",
  "description": "The shared bb plugins from github.com/Timmmmmmer/bb-plugins. Generated by scripts/build-marketplace.mjs; don't edit by hand.",
  "plugins": [
    {
      "id": "hub",
      "displayName": "Hub",
      "description": "Keeps the bb plugins from a shared public repository installed and up to date, with no tokens.",
      "icon": "Package",
      "author": {
        "name": "Timmmmmmer",
        "github": "Timmmmmmer"
      },
      "source": {
        "git": {
          "url": "https://github.com/Timmmmmmer/bb-plugins.git",
          "subdir": "plugins/hub",
          "ref": "main"
        }
      }
    },
    {
      "id": "server-badge",
      "displayName": "Server Badge",
      "description": "Shows whether this window is on the Development or Production bb server, and which one, in a small badge in the corner.",
      "icon": "Server",
      "author": {
        "name": "Timmmmmmer",
        "github": "Timmmmmmer"
      },
      "source": {
        "git": {
          "url": "https://github.com/Timmmmmmer/bb-plugins.git",
          "subdir": "plugins/server-badge",
          "ref": "main"
        }
      }
    },
    {
      "id": "sidebar-text",
      "displayName": "Sidebar text",
      "description": "Show a short message of your choice on its own page in the bb sidebar.",
      "icon": "MessageSquare",
      "author": {
        "name": "Timmmmmmer",
        "github": "Timmmmmmer"
      },
      "source": {
        "git": {
          "url": "https://github.com/Timmmmmmer/bb-plugins.git",
          "subdir": "plugins/sidebar-text",
          "ref": "main"
        }
      }
    }
  ]
}
